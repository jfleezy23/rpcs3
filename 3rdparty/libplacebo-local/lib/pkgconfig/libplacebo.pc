Name: libplacebo
Description: Reusable library for GPU-accelerated video/image rendering
Version: 7.362.0
Requires: shaderc >= 2019.1, vulkan
Libs: -L${libdir} -lplacebo -lshlwapi
Cflags: -I${includedir} -DPL_STATIC
