prefix=C:/Projects/RPCS3-fmv-lab/3rdparty/libplacebo-local
includedir=${prefix}/include
libdir=${prefix}/lib

pl_has_d3d11=0
pl_has_dovi=0
pl_has_gl_proc_addr=1
pl_has_glslang=0
pl_has_lcms=0
pl_has_libdovi=0
pl_has_opengl=0
pl_has_shaderc=1
